---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';

export type Crumb = { name: string; href: string };

interface Props {
  title: string;
  description: string;
  /** Nagłówek nałożony na scenę hero (tylko strona główna). */
  overlayHeader?: boolean;
  breadcrumbs?: Crumb[];
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  overlayHeader = false,
  breadcrumbs,
  image = '/og.jpg',
  noindex = false,
  jsonLd = [],
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://duonaut.com');
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', siteUrl).href;
const ogImage = new URL(image, siteUrl).href;
const fullTitle = Astro.url.pathname === '/' ? title : `${title} — ${site.name}`;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': new URL('/#organization', siteUrl).href,
  name: site.name,
  url: siteUrl.href,
  logo: new URL('/icon-512.png', siteUrl).href,
  slogan: 'Navigate the new',
  description: site.description,
  email: site.email,
  sameAs: [site.linkedin],
  areaServed: 'PL',
  knowsLanguage: 'pl',
};

const breadcrumbLd = breadcrumbs?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [{ name: 'Duonaut', href: '/' }, ...breadcrumbs].map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.name,
        item: new URL(c.href, siteUrl).href,
      })),
    }
  : null;

const structured = [organization, ...(breadcrumbLd ? [breadcrumbLd] : []), ...jsonLd];
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#FBFAF6" />

    <Font cssVariable="--font-jost" preload={[{ subset: 'latin' }, { subset: 'latin-ext' }]} />
    <Font cssVariable="--font-plex-mono" />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Duonaut — Navigate the new" />
    <meta name="twitter:card" content="summary_large_image" />

    {structured.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#tresc">Przejdź do treści</a>
    <Header overlay={overlayHeader} />
    <main id="tresc">
      <slot />
    </main>
    <Footer />
  </body>
</html>
