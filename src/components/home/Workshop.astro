---
// Sekcja 7 — Warsztat. Rejestr cichy. Pokazujemy, co system robi, a nie jak jest zbudowany.
import { getCollection } from 'astro:content';

const systems = (await getCollection('warsztat')).sort((a, b) => a.data.order - b.data.order);
---

<section class="section bg-warm workshop" aria-labelledby="warsztat">
  <div class="wrap">
    <div class="head">
      <div>
        <p class="label">04 — Warsztat</p>
        <h2 id="warsztat" class="h2">Budujemy własne narzędzia</h2>
      </div>
      <p class="head-note">Sprawdzamy na sobie to, co proponujemy klientom.</p>
    </div>

    <ul class="hairline-grid cards">
      {
        systems.map((s, i) => (
          <li>
            <a href={`/warsztat/${s.id}`} class="card">
              <span class="card-meta">System · {String(i + 1).padStart(2, '0')}</span>
              <span class="card-title">{s.data.title}</span>
              <span class="card-tagline">{s.data.tagline}</span>
              <span class="card-text">{s.data.summary}</span>
              <span class="link-mono card-link">Zobacz, co robi →</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="foot">
      <a href="/warsztat" class="link-arrow">Zobacz warsztat</a>
    </div>
  </div>
</section>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 32px;
    margin-bottom: 48px;
  }
  .head .label {
    margin-bottom: 16px;
  }
  .head-note {
    max-width: 30ch;
    font-size: 17px;
    font-weight: 300;
    color: var(--du-text-2);
  }
  .cards {
    grid-template-columns: repeat(2, 1fr);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    height: 100%;
    min-height: 280px;
    padding: 40px 36px;
    color: var(--du-ink);
    transition: background-color 0.3s ease;
  }
  .card:hover {
    background: var(--du-mist);
    color: var(--du-ink);
  }
  .card-meta {
    font-family: var(--du-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--du-ink-2);
  }
  .card-title {
    font-size: clamp(30px, 3vw, 40px);
    font-weight: 200;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .card-tagline {
    font-size: 18px;
    font-weight: 400;
    color: var(--du-ink-2);
  }
  .card-text {
    font-size: 16px;
    line-height: 1.6;
    color: var(--du-text-2);
    max-width: 48ch;
  }
  .card-link {
    margin-top: auto;
    padding-top: 12px;
    color: var(--du-ink-2);
  }
  .foot {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 24px;
    margin-top: 48px;
    padding-top: 28px;
    border-top: 1px solid var(--du-rule-16);
  }
  @media (max-width: 800px) {
    .head,
    .foot {
      flex-direction: column;
      align-items: flex-start;
    }
    .cards {
      grid-template-columns: 1fr;
    }
    .card {
      min-height: 0;
      padding: 32px 24px;
    }
  }
</style>
