---
// Sekcja 6 — Bezpieczeństwo i ład. Rejestr głębi: atrament z rozmytym polem koloru. Ton rzeczowy.
import { getImage } from 'astro:assets';
import field from '../../assets/sea/sea-field.jpg';

const fieldImg = await getImage({ src: field, format: 'webp', width: 300 });

const points = [
  {
    tag: 'Dane',
    title: 'Dane zostają u Ciebie.',
    text: 'Pracujemy na modelach uruchomionych w Twojej infrastrukturze, w uzgodnionym regionie przetwarzania — aż po własne środowisko AI, jeśli jest to wymagane.',
  },
  {
    tag: 'Właścicielstwo',
    title: 'Każde rozwiązanie ma właściciela.',
    text: 'Odpowiedzialność za to, co wdrażamy, jest w naszych rękach. Jej fundamentem jest jasne właścicielstwo: każde rozwiązanie ma wskazaną osobę, która odpowiada za jego dane, działanie i rozwój.',
  },
  {
    tag: 'Nadzór',
    title: 'Człowiek w pętli.',
    text: 'Na ustalonych etapach procesu istotne decyzje podejmuje człowiek. System przygotowuje i porządkuje, ale odpowiedzialność za rozstrzygnięcie pozostaje przy konkretnej osobie.',
  },
  {
    tag: 'Usługa',
    title: 'Wdrażamy AI jako usługę.',
    text: 'Zgodnie z najlepszymi praktykami zarządzania usługami IT: z katalogiem usług, określonym poziomem wsparcia i kontrolowanym zarządzaniem zmianą.',
  },
];
---

<section
  class="section bg-ink on-dark governance"
  aria-labelledby="lad"
  style={`--field: url(${fieldImg.src})`}
>
  <div class="field" aria-hidden="true"></div>

  <div class="wrap inner">
    <p class="label">03 — Bezpieczeństwo i ład</p>
    <h2 id="lad" class="h2 title">Wiemy, co działa, gdzie są dane i&nbsp;kto to utrzymuje</h2>

    <ul class="points">
      {
        points.map((p) => (
          <li class="point">
            <span class="dot" aria-hidden="true" />
            <p class="point-tag">{p.tag}</p>
            <h3 class="point-title">{p.title}</h3>
            <p class="point-text">{p.text}</p>
          </li>
        ))
      }
    </ul>

  </div>
</section>

<style>
  .governance {
    overflow: hidden;
  }
  .field {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(8, 59, 69, 0.9), rgba(8, 59, 69, 0.97)),
      var(--field) center / cover no-repeat;
    filter: saturate(0.9);
  }
  .inner {
    position: relative;
    z-index: 2;
  }
  .label {
    margin-bottom: 16px;
  }
  .title {
    max-width: 20ch;
    margin-bottom: 68px;
    color: var(--du-blue);
  }
  .points {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 42px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .points::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 11px;
    height: 1px;
    background: repeating-linear-gradient(
      90deg,
      rgba(185, 223, 242, 0.45) 0 6px,
      transparent 6px 12px
    );
  }
  .point {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .dot {
    width: 23px;
    height: 23px;
    border: 1px solid var(--du-blue);
    border-radius: 50%;
    background: var(--du-ink);
  }
  .point-tag {
    margin-top: 10px;
    font-family: var(--du-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(185, 223, 242, 0.7);
  }
  .point-title {
    font-size: 24px;
    line-height: 1.25;
    font-weight: 300;
    color: var(--du-ink-inv);
  }
  .point-text {
    font-size: 15px;
    line-height: 1.65;
    font-weight: 300;
    color: rgba(239, 247, 250, 0.75);
  }
  @media (max-width: 1000px) {
    .points {
      grid-template-columns: 1fr 1fr;
    }
    .points::before,
    .dot {
      display: none;
    }
  }
  @media (max-width: 600px) {
    .points {
      grid-template-columns: 1fr;
    }
  }
</style>
