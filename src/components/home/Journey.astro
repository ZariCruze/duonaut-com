---
// Sekcja 5 — Droga. Rejestr cichy, linia horyzontu jako oś kompozycji. Serce strony.
import { getCollection } from 'astro:content';
import { stages } from '../../data/journey';

const services = (await getCollection('droga')).sort((a, b) => a.data.order - b.data.order);
---

<section class="section bg-mist sun-bar journey" aria-labelledby="droga">
  <div class="wrap">
    <div class="head">
      <div>
        <p class="label">02 — Droga</p>
        <h2 id="droga" class="h2">Trzy etapy, jedna droga</h2>
      </div>
      <p class="head-note">
        Od kompetencji, przez dojrzałą implementację, do ciągłej ewolucji. Etapy mają sens
        w&nbsp;sekwencji.
      </p>
    </div>

    <ol class="axis" aria-hidden="true">
      {
        stages.map((s) => (
          <li>
            <span class="node">{s.numeral}</span>
          </li>
        ))
      }
    </ol>

    <ol class="hairline-grid stages">
      {
        stages.map((s) => (
          <li class="stage">
            <p class="stage-num">Etap {s.numeral}</p>
            <h3 class="h3">{s.name}</h3>
            <p class="small">{s.summary}</p>
            <ul class="tags" aria-label={`Usługi — ${s.name}`}>
              {services
                .filter((x) => x.data.stage === s.id)
                .map((x) => (
                  <li>
                    <a class="tag" href={`/droga/${x.id}`}>
                      {x.data.title}
                    </a>
                  </li>
                ))}
            </ul>
          </li>
        ))
      }
    </ol>

    <div class="foot">
      <a href="/droga" class="link-arrow">Zobacz całą Drogę</a>
    </div>
  </div>
</section>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 32px;
    margin-bottom: 56px;
  }
  .head .label {
    margin-bottom: 16px;
  }
  .head-note {
    max-width: 34ch;
    font-size: 17px;
    font-weight: 300;
    color: var(--du-text-2);
  }

  /* Oś horyzontu z trzema węzłami */
  .axis {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    list-style: none;
    margin: 0 0 28px;
    padding: 0;
  }
  .axis::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: repeating-linear-gradient(90deg, var(--du-rule-22) 0 6px, transparent 6px 12px);
  }
  .axis li {
    position: relative;
    padding-left: 36px;
  }
  .node {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 1px solid var(--du-ink-2);
    border-radius: 50%;
    background: var(--du-mist);
    font-family: var(--du-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
    color: var(--du-ink-2);
  }

  .stages {
    grid-template-columns: repeat(3, 1fr);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .stage {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-height: 380px;
    padding: 42px 36px 44px;
    transition: background-color 0.3s ease;
  }
  .stage:hover {
    background: var(--du-blue);
  }
  .stage-num {
    font-family: var(--du-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--du-ink-2);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: auto 0 0;
    padding: 12px 0 0;
    list-style: none;
  }

  .foot {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 24px;
    margin-top: 48px;
    padding-top: 28px;
    border-top: 1px solid var(--du-rule-16);
  }

  @media (max-width: 900px) {
    .head,
    .foot {
      flex-direction: column;
      align-items: flex-start;
    }
    .axis {
      display: none;
    }
    .stages {
      grid-template-columns: 1fr;
    }
    .stage {
      min-height: 0;
      padding: 32px 24px;
    }
  }
</style>
