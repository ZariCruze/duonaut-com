---
// Warstwa interakcji sceny: róża kompasu, celownik i ślad kursora.
// Element nadrzędny musi mieć atrybut data-scene i position: relative.
interface Props {
  tone?: 'light' | 'dark';
  rose?: boolean;
}
const { tone = 'light', rose = true } = Astro.props;
---

<div class:list={['scene-layer', `scene-layer--${tone}`]} aria-hidden="true">
  {
    rose && (
      <div class="rose" data-rose>
        <span class="rose-ring" />
        <span class="rose-square" />
      </div>
    )
  }
  <span class="cross cross-x" data-cross-x></span>
  <span class="cross cross-y" data-cross-y></span>
  <canvas class="trail" data-trail data-ink={tone === 'dark' ? '185,223,242' : '46,110,133'}
  ></canvas>
</div>

<script>
  import { initScenes } from '../scripts/scene';
  const start = () => initScenes();
  if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 2000 });
  else setTimeout(start, 300);
</script>

<style>
  .scene-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 1;
  }
  :global([data-scene]) {
    position: relative;
  }
  @media (pointer: fine) and (hover: hover) and (prefers-reduced-motion: no-preference) {
    :global([data-scene]) {
      cursor: crosshair;
    }
  }
  .rose,
  .cross {
    position: absolute;
    left: 0;
    top: 0;
    opacity: 0;
    transition: opacity 0.35s ease;
    will-change: transform;
  }
  .rose {
    width: 200px;
    height: 200px;
    margin: -100px 0 0 -100px;
  }
  .rose-ring,
  .rose-square {
    position: absolute;
    border: 1px solid rgba(46, 110, 133, 0.55);
  }
  .rose-ring {
    inset: 0;
    border-radius: 50%;
  }
  .rose-square {
    inset: 34%;
    border-color: rgba(46, 110, 133, 0.5);
  }
  .cross-x {
    bottom: 0;
    width: 1px;
    background: rgba(46, 110, 133, 0.6);
  }
  .cross-y {
    right: 0;
    height: 1px;
    background: rgba(46, 110, 133, 0.6);
  }
  .scene-layer--dark .rose-ring,
  .scene-layer--dark .rose-square {
    border-color: rgba(185, 223, 242, 0.5);
  }
  .scene-layer--dark .cross-x {
    background: linear-gradient(
      180deg,
      rgba(185, 223, 242, 0),
      rgba(185, 223, 242, 0.5),
      rgba(185, 223, 242, 0)
    );
  }
  .scene-layer--dark .cross-y {
    background: linear-gradient(
      90deg,
      rgba(185, 223, 242, 0),
      rgba(185, 223, 242, 0.5),
      rgba(185, 223, 242, 0)
    );
  }
  :global(.is-tracking) .rose {
    opacity: 0.9;
  }
  :global(.is-tracking) .cross {
    opacity: 1;
  }
  .trail {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
</style>
