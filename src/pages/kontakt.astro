---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';

const crumbs = [{ name: 'Kontakt', href: '/kontakt' }];
---

<Base
  title="Umów rozmowę"
  description="Trzydzieści minut rozmowy o sztucznej inteligencji w Twojej organizacji — bez prezentacji i bez zobowiązania. Odpowiadamy zwykle w ciągu jednego dnia roboczego."
  breadcrumbs={crumbs}
>
  <section class="contact bg-deep on-dark" aria-labelledby="h-kontakt">
    <div class="wrap grid">
      <div class="intro">
        <p class="label">Kontakt</p>
        <h1 id="h-kontakt" class="title">Umów rozmowę</h1>
        <p class="lead-inv">
          Napisz, czego potrzebuje Twoja organizacja. Trzydzieści minut rozmowy, bez prezentacji
          i&nbsp;bez zobowiązania.
        </p>
        <p class="response">{site.responseTime}</p>

        <div class="alt">
          <p class="label">Wolisz bez formularza</p>
          <ul>
            <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
            {
              site.phone && (
                <li>
                  <a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a>
                </li>
              )
            }
            <li><a href={site.linkedin} rel="noopener" target="_blank">LinkedIn</a></li>
            {
              site.bookingUrl && (
                <li>
                  <a href={site.bookingUrl} rel="noopener" target="_blank">
                    Zarezerwuj termin w kalendarzu
                  </a>
                </li>
              )
            }
          </ul>
        </div>
      </div>

      <form
        id="formularz"
        class="form"
        method="post"
        action="/api/contact"
        novalidate
        data-contact-form
      >
        <label class="field">
          <span class="field-label">W czym możemy pomóc</span>
          <textarea
            name="message"
            rows="5"
            required
            maxlength="5000"
            placeholder="Kilka zdań o tym, co chcecie osiągnąć…"></textarea>
        </label>
        <label class="field">
          <span class="field-label">E-mail</span>
          <input
            type="email"
            name="email"
            required
            maxlength="254"
            autocomplete="email"
            placeholder="imie.nazwisko@firma.pl"
          />
        </label>
        <label class="field">
          <span class="field-label">Organizacja</span>
          <input
            type="text"
            name="organization"
            maxlength="200"
            autocomplete="organization"
            placeholder="Nazwa organizacji"
          />
        </label>
        <div class="hp" aria-hidden="true">
          <label>Strona www <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>

        <button type="submit" class="btn btn--light submit" data-submit>Wyślij</button>
        <p class="status" role="status" aria-live="polite" data-status></p>
        <p class="legal">
          Dane z&nbsp;formularza wykorzystujemy wyłącznie, żeby odpowiedzieć na wiadomość.
          Szczegóły w&nbsp;<a href="/polityka-prywatnosci">polityce prywatności</a>.
        </p>
      </form>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = form?.querySelector<HTMLElement>('[data-status]');
  const submit = form?.querySelector<HTMLButtonElement>('[data-submit]');

  if (form && status && submit) {
    if (new URLSearchParams(location.search).get('status') === 'blad') {
      status.textContent = 'Nie udało się wysłać wiadomości. Spróbuj ponownie albo napisz do nas bezpośrednio.';
      status.dataset.state = 'error';
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.dataset.state = '';
      const invalid = Array.from(form.elements).find(
        (el): el is HTMLInputElement | HTMLTextAreaElement =>
          (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement) && !el.checkValidity(),
      );
      if (invalid) {
        status.textContent =
          invalid.name === 'email' ? 'Podaj poprawny adres e-mail.' : 'Napisz, w czym możemy pomóc.';
        status.dataset.state = 'error';
        invalid.focus();
        return;
      }

      submit.disabled = true;
      status.textContent = 'Wysyłamy…';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { accept: 'application/json' },
        });
        const data = await res.json().catch(() => ({ ok: false }));
        if (res.ok && data.ok) {
          window.location.href = '/kontakt/dziekujemy';
          return;
        }
        status.textContent = data.error || 'Nie udało się wysłać wiadomości. Spróbuj ponownie.';
        status.dataset.state = 'error';
      } catch {
        status.textContent = 'Brak połączenia. Spróbuj ponownie za chwilę.';
        status.dataset.state = 'error';
      }
      submit.disabled = false;
    });
  }
</script>

<style>
  .contact {
    position: relative;
    overflow: hidden;
    padding-block: clamp(80px, 10vw, 120px) clamp(96px, 11vw, 130px);
  }
  .grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: start;
  }
  .intro .label {
    margin-bottom: 16px;
  }
  .title {
    margin-bottom: 26px;
    font-size: clamp(44px, 5.4vw, 68px);
    line-height: 1;
    font-weight: 200;
    letter-spacing: -0.03em;
    color: var(--du-blue);
  }
  .lead-inv {
    max-width: 40ch;
    font-size: 19px;
    line-height: 1.6;
    color: rgba(239, 247, 250, 0.85);
  }
  .response {
    margin-top: 18px;
    font-family: var(--du-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: rgba(185, 223, 242, 0.75);
  }
  .alt {
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid var(--du-rule-inv);
  }
  .alt .label {
    margin-bottom: 14px;
  }
  .alt ul {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .alt a {
    font-family: var(--du-mono);
    font-size: 14px;
    letter-spacing: 0.06em;
    color: var(--du-blue);
  }
  .alt a:hover {
    color: var(--du-ink-inv);
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .field-label {
    font-family: var(--du-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(185, 223, 242, 0.7);
  }
  .field input,
  .field textarea {
    width: 100%;
    padding: 12px 2px;
    border: 0;
    border-bottom: 1px solid rgba(185, 223, 242, 0.4);
    border-radius: 0;
    background: transparent;
    font-family: var(--du-font);
    font-size: 18px;
    font-weight: 300;
    color: var(--du-ink-inv);
    outline: none;
    resize: vertical;
    transition: border-color 0.2s ease;
  }
  .field input::placeholder,
  .field textarea::placeholder {
    color: rgba(185, 223, 242, 0.45);
  }
  .field input:focus,
  .field textarea:focus {
    border-bottom-color: var(--du-blue);
  }
  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .submit {
    align-self: flex-start;
    margin-top: 10px;
  }
  .submit:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .status {
    min-height: 1.5em;
    font-size: 15px;
    color: var(--du-blue);
  }
  .status[data-state='error'] {
    color: var(--du-sun-deep);
  }
  .legal {
    font-size: 13px;
    line-height: 1.6;
    color: rgba(185, 223, 242, 0.6);
  }
  .legal a {
    color: rgba(185, 223, 242, 0.85);
    border-bottom: 1px solid rgba(185, 223, 242, 0.3);
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
